---
import { SITE, NAV, CONTACT, SOCIAL, whatsappLink } from '@lib/config';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <img src="/logos/logo-cream.png" alt={SITE.name} width="220" height="70" />
      <p class="footer__manifesto">
        Arte, cultura e entretenimento que se conectam com você. Cada apresentação, uma celebração única.
      </p>
      <div class="footer__socials">
        <a href={SOCIAL.instagram.url} target="_blank" rel="noopener noreferrer" aria-label="Instagram da Culturalia">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
          <span>{SOCIAL.instagram.handle}</span>
        </a>
      </div>
    </div>

    <div class="footer__col">
      <h4>Navegação</h4>
      <ul>
        {NAV.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer__col">
      <h4>Contato</h4>
      <ul>
        <li>
          <a href={whatsappLink()} target="_blank" rel="noopener noreferrer">
            WhatsApp: {CONTACT.whatsappDisplay}
          </a>
        </li>
        <li><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
        <li>{SITE.city}, {SITE.state} — Brasil</li>
      </ul>
    </div>

    <div class="footer__col">
      <h4>Legal</h4>
      <ul>
        <li><a href="/privacidade">Política de Privacidade</a></li>
        <li><a href="/termos">Termos de Uso</a></li>
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p>© {year} {SITE.name}. Todos os direitos reservados.</p>
      <p class="footer__slogan">{SITE.slogan}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-navy);
    color: var(--color-cream);
    padding-top: var(--space-9);
    position: relative;
    overflow: hidden;
  }
  .footer::before {
    content: '';
    position: absolute;
    top: -40px; right: -40px;
    width: 160px; height: 160px;
    background: var(--color-magenta);
    border-radius: 50%;
    opacity: 0.18;
  }
  .footer::after {
    content: '';
    position: absolute;
    bottom: 60px; left: -50px;
    width: 130px; height: 130px;
    background: var(--color-mustard);
    border-radius: 50%;
    opacity: 0.12;
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.2fr 1fr;
    gap: 3rem;
    padding-bottom: var(--space-8);
    position: relative;
    z-index: 1;
  }

  .footer__brand img { height: 64px; width: auto; margin-bottom: 1.25rem; }
  .footer__manifesto {
    font-size: var(--fs-sm);
    line-height: 1.6;
    opacity: 0.85;
    max-width: 32ch;
    margin-bottom: 1.5rem;
  }

  .footer__socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-cream);
    padding: 0.5rem 0.9rem;
    background: rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
    font-weight: 500;
    transition: background var(--t-fast) var(--ease);
  }
  .footer__socials a:hover { background: rgba(255, 255, 255, 0.14); color: var(--color-cyan); }

  .footer__col h4 {
    font-family: var(--font-heading);
    font-size: var(--fs-base);
    color: var(--color-pink);
    margin-bottom: 1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .footer__col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .footer__col a {
    color: var(--color-cream);
    font-size: var(--fs-sm);
    opacity: 0.82;
    transition: opacity var(--t-fast), color var(--t-fast);
  }
  .footer__col a:hover { opacity: 1; color: var(--color-cyan); }
  .footer__col li { font-size: var(--fs-sm); opacity: 0.82; }

  .footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-block: 1.5rem;
    position: relative;
    z-index: 1;
  }
  .footer__bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: var(--fs-sm);
    opacity: 0.7;
  }
  .footer__bottom-inner p { margin: 0; }
  .footer__slogan {
    font-family: var(--font-display);
    color: var(--color-mustard);
    opacity: 1;
    letter-spacing: 0.02em;
  }

  @media (max-width: 880px) {
    .footer__inner { grid-template-columns: 1fr 1fr; gap: 2rem; }
    .footer__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 540px) {
    .footer__inner { grid-template-columns: 1fr; }
  }
</style>
