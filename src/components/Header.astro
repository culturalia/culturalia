---
import { NAV, SITE } from '@lib/config';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__brand" aria-label={`Ir para a página inicial — ${SITE.name}`}>
      <img src="/logos/logo-color.png" alt={SITE.name} width="200" height="65" />
    </a>

    <nav class="nav" aria-label="Navegação principal">
      <ul class="nav__list">
        {NAV.map((item) => {
          const active = currentPath === item.href.replace(/\/$/, '');
          return (
            <li>
              <a href={item.href} class={`nav__link ${active ? 'is-active' : ''}`}>
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <button class="nav-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <ul>
      {NAV.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(252, 234, 229, 0.92);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.875rem;
  }

  .header__brand img {
    height: 52px;
    width: auto;
    transition: transform var(--t-fast) var(--ease);
  }
  .header__brand:hover img { transform: rotate(-2deg) scale(1.03); }

  .nav__list {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__link {
    display: inline-block;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-navy);
    transition: background var(--t-fast) var(--ease), color var(--t-fast) var(--ease);
  }
  .nav__link:hover { background: var(--color-cream-dark); color: var(--color-magenta); }
  .nav__link.is-active { background: var(--color-navy); color: var(--color-cream); }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 0.5rem;
    border-radius: 8px;
    background: transparent;
  }
  .nav-toggle span {
    display: block;
    width: 26px;
    height: 3px;
    background: var(--color-navy);
    border-radius: 999px;
    transition: transform var(--t-fast) var(--ease), opacity var(--t-fast) var(--ease);
  }

  .mobile-menu {
    display: none;
    padding: 1rem var(--container-pad) 2rem;
    border-top: 1px solid var(--border);
  }
  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .mobile-menu a {
    display: block;
    padding: 0.9rem 1rem;
    border-radius: var(--radius-md);
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-navy);
    background: var(--bg-alt);
  }
  .mobile-menu a:hover { background: var(--color-cream-dark); }

  @media (max-width: 880px) {
    .nav { display: none; }
    .nav-toggle { display: flex; }
    .mobile-menu[data-open='true'] { display: block; }
    .header__brand img { height: 44px; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.getAttribute('data-open') === 'true';
    if (open) {
      menu?.removeAttribute('data-open');
      menu?.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
    } else {
      menu?.setAttribute('data-open', 'true');
      menu?.removeAttribute('hidden');
      toggle.setAttribute('aria-expanded', 'true');
    }
  });
</script>
