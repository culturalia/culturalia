---
import Layout from '@layouts/Layout.astro';
import Shapes from '@components/Shapes.astro';
import { CONTACT, SOCIAL, SITE, whatsappLink } from '@lib/config';
---

<Layout
  title="Contato"
  description="Fale com a Culturalia. WhatsApp, e-mail e Instagram para conversar sobre projetos, parcerias e espetáculos."
>
  <section class="page-hero">
    <Shapes variant="confetti" />
    <div class="container">
      <span class="selo selo--royal">Contato</span>
      <h1>Vamos <span class="text-magenta">conversar</span>?</h1>
      <p class="lead">
        Conta seu projeto, sua ideia ou só passe pra dizer oi. A gente responde rápido —
        de preferência pelo WhatsApp.
      </p>
    </div>
  </section>

  <section class="section contato-section">
    <div class="container">
      <div class="contato-grid">
        <a class="contato-card contato-card--whatsapp" href={whatsappLink()} target="_blank" rel="noopener noreferrer">
          <div class="contato-card__icon">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
          </div>
          <h3>WhatsApp</h3>
          <p class="contato-card__value">{CONTACT.whatsappDisplay}</p>
          <span class="contato-card__cta">Abrir conversa →</span>
        </a>

        <a class="contato-card contato-card--email" href={`mailto:${CONTACT.email}`}>
          <div class="contato-card__icon">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <h3>E-mail</h3>
          <p class="contato-card__value">{CONTACT.email}</p>
          <span class="contato-card__cta">Enviar mensagem →</span>
        </a>

        <a class="contato-card contato-card--insta" href={SOCIAL.instagram.url} target="_blank" rel="noopener noreferrer">
          <div class="contato-card__icon">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </div>
          <h3>Instagram</h3>
          <p class="contato-card__value">{SOCIAL.instagram.handle}</p>
          <span class="contato-card__cta">Seguir →</span>
        </a>
      </div>

      <div class="contato-location">
        <div class="contato-location__icon">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
        </div>
        <div>
          <strong>{SITE.city}, {SITE.state}</strong>
          <p>Atuação em todo o território nacional.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <h2>Pronto pra colocar sua ideia no palco?</h2>
      <a class="btn btn--primary" href={whatsappLink()} target="_blank" rel="noopener noreferrer">
        Chama no WhatsApp
      </a>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding-block: clamp(4rem, 8vw, 6rem);
    background: var(--color-cream);
    position: relative;
    overflow: hidden;
  }
  .page-hero h1 {
    font-family: var(--font-heading);
    font-size: var(--fs-4xl);
    margin: 1rem 0;
  }
  .page-hero .lead { font-size: var(--fs-md); color: var(--text-soft); max-width: 60ch; }

  .contato-section { background: var(--bg-alt); }

  .contato-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }
  .contato-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 2.5rem 2rem;
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: transform var(--t-base) var(--ease), box-shadow var(--t-base) var(--ease);
    position: relative;
    overflow: hidden;
  }
  .contato-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); }
  .contato-card__icon {
    width: 64px; height: 64px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }
  .contato-card h3 { font-size: var(--fs-lg); margin: 0; }
  .contato-card__value { font-family: var(--font-heading); font-weight: 600; margin: 0; opacity: 0.9; }
  .contato-card__cta { margin-top: 1rem; font-weight: 600; opacity: 0.85; }

  .contato-card--whatsapp { background: #25D366; color: #fff; }
  .contato-card--whatsapp .contato-card__icon { background: rgba(255,255,255,0.18); color: #fff; }
  .contato-card--whatsapp h3, .contato-card--whatsapp .contato-card__value { color: #fff; }

  .contato-card--email { background: var(--color-royal); color: #fff; }
  .contato-card--email .contato-card__icon { background: rgba(255,255,255,0.18); color: #fff; }
  .contato-card--email h3, .contato-card--email .contato-card__value { color: #fff; }

  .contato-card--insta {
    background: linear-gradient(135deg, var(--color-magenta), var(--color-orange) 60%, var(--color-mustard));
    color: #fff;
  }
  .contato-card--insta .contato-card__icon { background: rgba(255,255,255,0.18); color: #fff; }
  .contato-card--insta h3, .contato-card--insta .contato-card__value { color: #fff; }

  .contato-location {
    margin-top: 3rem;
    display: flex;
    gap: 1.5rem;
    align-items: center;
    padding: 1.5rem 2rem;
    background: var(--color-cream);
    border-radius: var(--radius-md);
  }
  .contato-location__icon {
    width: 48px; height: 48px;
    background: var(--color-navy);
    color: var(--color-cream);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .contato-location strong { display: block; font-family: var(--font-heading); font-size: var(--fs-md); }
  .contato-location p { margin: 0; color: var(--text-soft); font-size: var(--fs-sm); }

  .cta-band {
    background: var(--color-navy);
    color: var(--color-cream);
    padding-block: var(--space-8);
    text-align: center;
  }
  .cta-band h2 { color: var(--color-cream); font-size: var(--fs-2xl); margin-bottom: 1.5rem; }
</style>
